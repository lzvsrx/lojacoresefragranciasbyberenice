# Gere uma chave longa e aleatória antes de publicar o sistema.
# Exemplo no PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-64-caracteres
PORT=3001

# Banco persistente compartilhado entre o computador e a Vercel.
# Deixe vazio para usar somente o SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Caminho opcional do SQLite local (não use /tmp como banco de produção).
# DATABASE_PATH=C:/dados/loja/store.db
