# Gere uma chave longa e aleatória antes de publicar o sistema.
# Exemplo no PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-64-caracteres
PORT=3001

# Produção recusa chave fraca, ausência de PUBLIC_BASE_URL e acesso HTTP.
# Configure o proxy reverso para terminar HTTPS e sobrescrever X-Forwarded-Proto.
# NODE_ENV=production
# TRUST_PROXY_HOPS=1
# CORS_ORIGINS=https://outro-dominio-autorizado.com.br
# HOST=127.0.0.1

# Checkout Pro Mercado Pago. Use credenciais de teste antes da produção.
# URL da loja, somente origem HTTPS e sem caminho (ex.: https://minhaloja.com.br).
# PUBLIC_BASE_URL=https://lojacoresefragranciasbyberenice.vercel.app
# MERCADO_PAGO_ACCESS_TOKEN=seu-access-token-privado
# MERCADO_PAGO_PUBLIC_KEY=sua-chave-publica
# MERCADO_PAGO_WEBHOOK_SECRET=sua-assinatura-secreta-do-webhook
# MERCADO_PAGO_SANDBOX=true
# Alertas de fraude autenticados: bloquear entrega e devolver valores recebidos.
# MERCADO_PAGO_AUTO_REFUND_FRAUD=true
# MERCADO_PAGO_STATEMENT_DESCRIPTOR=CORESBERENICE
# MERCADO_PAGO_CATEGORY_ID=others
# Somente se o Mercado Pago fornecer um ID oficial para o seu integrador:
# MERCADO_PAGO_INTEGRATOR_ID=
# O comando npm run payments:configure gera JWT_SECRET e CRON_SECRET sem exibi-los.
# Configure também CRON_SECRET na Vercel para autenticar o cron de recuperação.
# CRON_SECRET=gere-uma-chave-aleatoria-com-32-bytes-ou-mais

# Caminho opcional do SQLite local (não use /tmp como banco de produção).
# DATABASE_PATH=C:/dados/loja/store.db

# Banco persistente compartilhado entre computador e Vercel.
# Migre o SQLite com npm run migrate:cloud antes de ativar estas variáveis na Vercel.
# Ao definir estas variáveis localmente, o servidor local também usa o banco remoto.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token-privado
